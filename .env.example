# Copier ce fichier en `.env` et remplir avec les valeurs du projet Supabase
# (Project Settings → API). Sans ces variables, le site tourne en mode démo :
# tout est stocké dans le navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Facultatif — Microsoft Clarity (enregistrement des sessions, gratuit).
# clarity.microsoft.com → nouveau projet → l'identifiant est dans le code
# de suivi. Laisser vide n'injecte aucun script tiers.
VITE_CLARITY_ID=
